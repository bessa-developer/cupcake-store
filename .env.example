# A connection string do Postgres fica no .env.local, gerado pela Neon
# (neon init). Nao e preciso preencher o DATABASE_URL aqui.
#
# Use este arquivo como modelo do .env para as demais variaveis.
# O .env e o .env.local nunca vao para o repositorio (estao no .gitignore).

SECRET_KEY=troque-por-uma-chave-secreta
